# Architecture Studio - optional account saving ("Sign in with ChatGPT").
#
# Leave these unset and the site still works: rooms save to the browser, and the
# studio hides the account UI instead of offering a button that cannot work.
# Set all of them to turn account saving on.

# --- Sign in with ChatGPT (OpenID Connect) -----------------------------------
# From your OpenAI platform app. Register this exact redirect URI:
#   https://<your-domain>/api/auth/callback
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=

# Optional. Defaults to https://auth.openai.com; endpoints are read from the
# issuer's /.well-known/openid-configuration rather than hardcoded.
# OPENAI_ISSUER=https://auth.openai.com
# OPENAI_SCOPE=openid profile email

# Optional. Pin the origin used to build the redirect URI. Without it the
# request's forwarded host is used, which is right for normal Vercel deploys but
# gives each preview deployment its own URI.
# STUDIO_PUBLIC_ORIGIN=https://your-domain.example

# --- Where saved rooms live --------------------------------------------------
# Any Redis speaking the REST protocol: Vercel KV, Upstash, or compatible.
# Vercel's Upstash integration sets the KV_* pair for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash's own names work too:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
